# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parking_system?schema=public"

# JWT Authentication
# Generate a strong random secret for production (e.g., using: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-minimum-32-characters"

# CV/Computer Vision Secret (optional)
# Used for computer vision integration
CV_SECRET="your-cv-secret-key"

# Redis Configuration (optional, for caching and sessions)
REDIS_URL="redis://localhost:6379"

# MinIO Configuration (optional, for file storage)
# If not using MinIO, file uploads will be stored locally in uploads/ directory
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_USE_SSL=false
MINIO_BUCKET="parking-system"

# Test Database (optional, for running tests)
# DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/parking_system_test?schema=public"
