// Prisma Schema for Node.js/TypeScript
// Location: backend/prisma/schema.prisma
// Run: npx prisma migrate dev --name init
// Run: npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.Text
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}


model User {
  id            Int       @id @default(autoincrement()) @map("user_id")
  refreshTokens RefreshToken[]
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  phoneNumber   String?   @map("phone_number") @db.VarChar(20)
  role          UserRole  @default(CUSTOMER)
  isVerified    Boolean   @default(false) @map("is_verified")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLogin     DateTime? @map("last_login")

  bookings      Booking[]
  payments      Payment[]

  @@index([email])
  @@index([role])
  @@map("users")
}

enum UserRole {
  CUSTOMER  @map("customer")
  ADMIN     @map("admin")
  OPERATOR  @map("operator")
}

model ParkingLot {
  id              Int       @id @default(autoincrement()) @map("lot_id")
  name            String    @db.VarChar(255)
  address         String    @db.Text
  city            String    @db.VarChar(100)
  country         String    @default("Kazakhstan") @db.VarChar(100)
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  type            ParkingType @default(INDOOR)
  description     String?   @db.Text
  totalFloors     Int       @default(1) @map("total_floors")
  hourlyRate      Decimal   @map("hourly_rate") @db.Decimal(10, 2)
  dailyRate       Decimal?  @map("daily_rate") @db.Decimal(10, 2)

  openingTime     DateTime  @default(dbgenerated("'00:00:00'::time")) @map("opening_time") @db.Time()
  closingTime     DateTime  @default(dbgenerated("'23:59:59'::time")) @map("closing_time") @db.Time()
  is24Hours       Boolean   @default(true) @map("is_24_hours")

  hasEvCharging   Boolean   @default(false) @map("has_ev_charging")
  hasDisabledSpots Boolean  @default(false) @map("has_disabled_spots")
  hasCoveredParking Boolean @default(false) @map("has_covered_parking")
  hasSecurity     Boolean   @default(false) @map("has_security")

  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  spots           ParkingSpot[]
  bookings        Booking[]

  @@index([city])
  @@index([type])
  @@index([isActive])
  @@map("parking_lots")
}

enum ParkingType {
  INDOOR    @map("indoor")
  OUTDOOR   @map("outdoor")
  STREET    @map("street")
}

model ParkingSpot {
  id            Int         @id @default(autoincrement()) @map("spot_id")
  lotId         Int         @map("lot_id")
  spotNumber    String      @map("spot_number") @db.VarChar(20)
  floorLevel    String      @map("floor_level") @db.VarChar(20)
  spotType      SpotType    @default(STANDARD) @map("spot_type")
  status        SpotStatus  @default(AVAILABLE)

  rowPosition   Int?        @map("row_position")
  colPosition   Int?        @map("col_position")

  hasCover      Boolean     @default(false) @map("has_cover")
  hasEvCharger  Boolean     @default(false) @map("has_ev_charger")

  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  parkingLot    ParkingLot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@unique([lotId, spotNumber], name: "unique_spot_per_lot")
  @@index([lotId])
  @@index([status])
  @@index([floorLevel])
  @@index([spotType])
  @@map("parking_spots")
}

enum SpotType {
  STANDARD      @map("standard")
  COMPACT       @map("compact")
  DISABLED      @map("disabled")
  EV_CHARGING   @map("ev-charging")
  MOTORCYCLE    @map("motorcycle")
}

enum SpotStatus {
  AVAILABLE     @map("available")
  OCCUPIED      @map("occupied")
  RESERVED      @map("reserved")
  MAINTENANCE   @map("maintenance")
  DISABLED      @map("disabled")
}

model Booking {
  id                Int           @id @default(autoincrement()) @map("booking_id")
  bookingReference  String        @unique @map("booking_reference") @db.VarChar(50)

  userId            Int           @map("user_id")
  lotId             Int           @map("lot_id")
  spotId            Int           @map("spot_id")

  startTime         DateTime      @map("start_time")
  endTime           DateTime      @map("end_time")
  actualStartTime   DateTime?     @map("actual_start_time")
  actualEndTime     DateTime?     @map("actual_end_time")

  hourlyRate        Decimal       @map("hourly_rate") @db.Decimal(10, 2)
  durationHours     Decimal       @map("duration_hours") @db.Decimal(10, 2)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(10, 2)

  vehiclePlateNumber String?      @map("vehicle_plate_number") @db.VarChar(20)
  vehicleType        String?      @map("vehicle_type") @db.VarChar(50)

  status            BookingStatus @default(PENDING)

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  cancelledAt       DateTime?     @map("cancelled_at")

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parkingLot        ParkingLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  parkingSpot       ParkingSpot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  payment           Payment?

  @@index([userId])
  @@index([lotId])
  @@index([spotId])
  @@index([status])
  @@index([startTime])
  @@index([bookingReference])
  @@map("bookings")
}

enum BookingStatus {
  PENDING       @map("pending")
  CONFIRMED     @map("confirmed")
  ACTIVE        @map("active")
  COMPLETED     @map("completed")
  CANCELLED     @map("cancelled")
  NO_SHOW       @map("no-show")
}

model Payment {
  id                Int             @id @default(autoincrement()) @map("payment_id")
  paymentReference  String          @unique @map("payment_reference") @db.VarChar(50)

  bookingId         Int             @unique @map("booking_id")
  userId            Int             @map("user_id")

  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("USD") @db.VarChar(3)
  paymentMethod     PaymentMethod   @default(CARD) @map("payment_method")

  cardLastFour      String?         @map("card_last_four") @db.VarChar(4)
  cardBrand         String?         @map("card_brand") @db.VarChar(20)
  cardholderName    String?         @map("cardholder_name") @db.VarChar(255)

  status            PaymentStatus   @default(PENDING)

  transactionId     String?         @map("transaction_id") @db.VarChar(255)
  paymentGateway    String          @default("stripe") @map("payment_gateway") @db.VarChar(50)

  createdAt         DateTime        @default(now()) @map("created_at")
  processedAt       DateTime?       @map("processed_at")
  failedAt          DateTime?       @map("failed_at")
  refundedAt        DateTime?       @map("refunded_at")

  errorMessage      String?         @map("error_message") @db.Text

  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([paymentReference])
  @@index([transactionId])
  @@map("payments")
}

enum PaymentMethod {
  CARD          @map("card")
  CASH          @map("cash")
  WALLET        @map("wallet")
  BANK_TRANSFER @map("bank_transfer")
}

enum PaymentStatus {
  PENDING       @map("pending")
  PROCESSING    @map("processing")
  COMPLETED     @map("completed")
  FAILED        @map("failed")
  REFUNDED      @map("refunded")
  CANCELLED     @map("cancelled")
}
